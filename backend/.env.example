APP_NAME=Railway Multi-Target Recognition API
DATA_DIR=./data
DATABASE_URL=postgresql+psycopg://deipss:YOUR_PASSWORD@127.0.0.1:5432/railway_recognition
INFERENCE_BACKEND=ultralytics
MODEL_PATH=./yolo11n.pt
DEEPSEEK_VL2_MODEL_PATH=./models/deepseek-vl2-tiny
DEEPSEEK_VL2_PROMPT=请用中文简要描述这张图片的主要内容，并列出可见目标。
DEVICE=0
RUN_TASKS_INLINE=true
TASK_WORKER_ENABLED=false
TASK_POLL_INTERVAL_SECONDS=1
CORS_ORIGINS=http://localhost:4021,http://127.0.0.1:4021,http://47.120.48.245:14021
# 本地大模型对话（Ollama）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3:14b
OLLAMA_TIMEOUT_SECONDS=15
# 本地语音合成（Piper）
TTS_VOICE_ZH=zh_CN-huayan-medium
TTS_VOICE_EN=en_US-lessac-medium
TTS_VOICES_DIR=./models/piper-voices
